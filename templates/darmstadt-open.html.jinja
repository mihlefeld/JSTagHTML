{# TagHTML Nametag Template - Full Page Layout #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        :root {
            --tag-width: 9cm;
            --tag-height: 6cm;
            --page-width: 21cm;
            --page-height: 29.7cm;
            --primary: oklch(0.8 0.1 28.31);
            --secondary: oklch(0.8 0.1 234);
            --tertiary: oklch(0.8 0.1 78.52);
        }
        
        body {
          font-family: sans-serif;
        }
        
        @page {
            size: var(--page-width) var(--page-height);
        } 
        
        .nametags { 
            display: grid; 
            grid-template-columns: repeat(auto-fill, var(--tag-width)); 
        }
        
        .nametag {
          width: var(--tag-width);
          height: var(--tag-height);
          page-break-inside: avoid;
          box-sizing: border-box;
          border: 0.1cm dashed #333;
          display: flex;
          flex-direction: column;
          align-items: center;
          overflow: hidden;
          padding: 0.1cm;
          justify-content: center;
          position: relative;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ef 100%);
        }

        .event-img {
            height: 0.3cm;
        }
        
        .assignments {
          align-self: start;
          display: grid;
          grid-template-rows: 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr; 
          grid-auto-flow: column;
          box-sizing: border-box;
          gap: 0.05cm;
          height: 100%;
        }
        
        .event {
          border-radius: 0.1cm;
          display: flex;
          flex-direction: row;
          justify-content: center;
          align-items: center;
          width: 1.68cm;
          height: 0.52cm;
          font-size: 0.18cm;
          padding: 0.05cm;
          box-sizing: border-box;
          gap: 0.05cm;
        }
        
        .day-Fr {
          background: var(--tertiary);
        }
        .day-Fr.inactive {
          background: color(from var(--tertiary) xyz calc(x) calc(y) z);
        }
        .day-Sa {
          background: var(--secondary);
        }
        .day-Sa.inactive {
          background: oklch(0.8 0.05 234);
        }
        .day-So {
          background: var(--primary);
        }
        .day-So.inactive {
          background: oklch(0.8 0.05 28.31);
        }
        .back-name {
          margin: 0;
          padding: 0;
          font-weight: 800;
          align-text: top;
          height: 1em;
          line-height: 1em;
          padding-bottom: 0.1cm;
        }
        
        .front-name {
          font-weight: 800;
          font-size: xx-large;
          text-align: center;
          width: 5cm;
          height: 2.3cm;
          position: absolute;
          top: 1.2cm;
          margin: 0;
          z-index: 2;
        }
        
        .logo {
          height: 1em;
        }
        .front-country-flag {
          height: 1.5cm;
          z-index: 2;
        }
        .front-qr {
          height: 1.5cm;
          position: absolute;
          left: 0.2cm;
          bottom: 0.8cm;
          
        }
        .front-id {
          font-weight: 800;
          font-size: large;
        }
        .front-logo-row {
          position: absolute;
          bottom: 0;
          width: var(--tag-width);
          display: flex;
          justify-content: space-between;
          padding: 0.2cm;
          box-sizing: border-box;
          align-items: baseline;
        }
        .comp-logo {
          position: absolute;
          height: 2.8cm;
          top: 0.9cm;
          z-index: 1;
          opacity: 0.2;
          
        }
        .front-competition-name {
          position: absolute;
          top: 0.05cm;
          font-weight: bold;
          opacity: 0.5;
        }
        .back {
        
        }
        .legend {
          background: oklch(0.88 0.0 250);
          color: black;
        }
    </style>
</head>
<body>
    <div class="nametags">
    {% for person in persons | sort(false, false, "name") %}
        <div class="nametag front">
            <p class="front-competition-name">{{competition.name}}</p>
            <h2 class="front-name adjust-size-to-fit">{{ person.name.split("(")[0] }}</h2>
            <img class="comp-logo" src="{{ file_url('zbls.svg') }} "/>
            <div class="front-logo-row">
              <span class="front-id">ID: {{ person.id }}</span>
              <img class="front-country-flag" src="/JSTagHTML/assets/flags/{{ person.countryIso2 | lower}}.png"/>
              <img class="front-qr" src="{{ ("https://www.competitiongroups.com/competitions/"+ competition.id + "/persons/" + person.id) | makeqr(6, 2, "L") }}"/>
              <div class="logo-group">
                <img class="logo" src="https://www.germancubeassociation.de/wp-content/uploads/2021/12/GCA_original_larger_no_shadow-300x117.png">
                <img class="logo" src="https://assets.worldcubeassociation.org/assets/b4ea5cf/packs/static/components/StaticPages/LogoImages/1%20Positive%20Primary/WCA%20Logo-11f76952edde63e7601d.svg">
              </div>
            </div>
        </div>
        <div class="nametag back">
            <p class="back-name">{{person.name.split("(")[0] }}</p>
            {% if person.schedule %}
            <div class="assignments">
            <div class="event day-Sa">Samstag</div>
            {% for event in person.schedule.group_schedule %}
            {% if event.activity.event == "222" and event.activity.round == 1  and event.activity.group == 1 %}
              <div class="event day-So">Sonntag</div>
            {% endif %}
            <div class="event day-{{ event.activity.group_start.toLocaleString('de-de', {"weekday": "short"}) }} {{ "active" if event.roles[0] else "inactive"}}">
              <img class="event-img" src="/JSTagHTML/assets/svgs/{{ event.activity.event }}.svg">
              <span>R{{event.activity.round}}G{{ event.activity.group }}</span>
              <span>
                {{ event.roles[0][0] | upper}}
              </span>
              <span>{{ event.activity.group_start.toLocaleTimeString('de-de', {hour: "2-digit", "minute": "2-digit"}) }}</span>
            </div>
            {% endfor %}
            <div class="event legend">J = Judge</div>
            <div class="event legend">C = Competitor</div>
            <div class="event legend">R = Runner</div>
            <div class="event legend">S = Scrambler</div>
            </div>
            {% else %}
            <p><em>No events assigned</em></p>
            {% endif %}
        </div>
    {% endfor %}
    </div>
    <script>
    document.querySelectorAll('.adjust-size-to-fit').forEach(function(el) {
      const originalFontSize = parseFloat(window.getComputedStyle(el).fontSize);
      let fontSize = originalFontSize;
      const parentWidth = el.clientWidth;
      const parentHeight = el.clientHeight;

      // Create a clone for measurement
      const clone = el.cloneNode(true);
      clone.style.visibility = 'hidden';
      clone.style.position = 'absolute';
      clone.style.left = '-9999px';
      clone.style.top = '-9999px';
      clone.style.width = parentWidth + 'px';
      clone.style.height = parentHeight;
      clone.style.whiteSpace = 'wrap';
      document.body.appendChild(clone);

      // Reduce font size until it fits or reaches original minimum
      while ((clone.scrollWidth > parentWidth || clone.scrollHeight > parentHeight) && fontSize > 4) {
        fontSize -= 1;
        clone.style.fontSize = fontSize + 'px';
      }

      // Apply the new font size, but never increase it
      el.style.fontSize = Math.min(fontSize, originalFontSize) + 'px';
      document.body.removeChild(clone);
    });
    </script>
</body>
</html>